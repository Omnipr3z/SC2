# Ignorer tous les fichiers et dossiers par défaut
/*

# Ne pas ignorer la configuration et la documentation
!.gitignore
!README.md
!WALKTROUGHT.md
!WALKTHROUGH.md

# Conserver data/ (données de l'éditeur RPG Maker)
!/data/
!/data/**

# Conserver js/plugins/ et js/plugins.js
!/js/
/js/*
!/js/plugins.js
!/js/plugins/
!/js/plugins/**

# Conserver img/characters/ et img/ui/
!/img/
/img/*
!/img/characters/
!/img/characters/**
!/img/ui/
!/img/ui/**

# Conserver les tests unitaires
!/UNIT_TESTS/
!/UNIT_TESTS/**

